---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Section from '~/components/lab/Section.astro';
import NewsList from '~/components/lab/NewsList.astro';

const metadata = {
  title: 'News',
};
---

<Layout metadata={metadata}>
  <HeroText title="News" />

  <Section containerClass="max-w-4xl py-6 pb-12 md:py-8 md:pb-16 lg:pb-20">
    <NewsList />
  </Section>
</Layout>
