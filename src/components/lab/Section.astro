---
import type { HTMLTag } from 'astro/types';
import { twMerge } from 'tailwind-merge';

/**
 * Page section wrapper.
 *
 * Same layout, spacing and scroll-in animation as the template's
 * WidgetWrapper, with two deliberate differences:
 *
 * 1. No `not-prose` class. `not-prose` on an ancestor disables
 *    @tailwindcss/typography for everything below it, so a nested `prose`
 *    block would lose its headings, lists and link styling.
 *
 * 2. No `intersect-quarter`. That sets the reveal threshold to 0.25, meaning a
 *    quarter of the section must be on screen before it fades in — impossible
 *    for a section taller than four viewports, which would then stay at
 *    `opacity: 0` forever. The publication list is ~6000px tall, so it would
 *    never appear on a desktop window. The default threshold of 0 reveals a
 *    section as soon as any part of it scrolls into view, at any length.
 *
 * 3. No default vertical padding at all — each page sets its own via
 *    `containerClass`. twMerge only resolves conflicts within a single
 *    breakpoint, so a default like `py-12 md:py-16 lg:py-20` cannot be fully
 *    overridden: `pt-0` clears the base step but leaves `md:py-16` standing,
 *    and `py-6 md:py-8` leaves `lg:py-20` standing. The result is padding
 *    that silently ignores what the page asked for above 768px. Owning the
 *    spacing per page keeps what is written the thing that renders.
 */
export interface Props {
  id?: string;
  containerClass?: string;
  ['as']?: HTMLTag;
}

const { id, containerClass = '', as = 'section' } = Astro.props;

const WrapperTag = as;
---

<WrapperTag class="relative scroll-mt-[72px]" {...id ? { id } : {}}>
  <div
    class={twMerge(
      'relative mx-auto max-w-7xl px-4 md:px-6 text-default intersect-once intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
      containerClass
    )}
  >
    <slot />
  </div>
</WrapperTag>
